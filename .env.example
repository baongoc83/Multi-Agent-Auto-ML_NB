# ── LiteLLM Proxy (required) ─────────────────────────────────────────────────
# Start the proxy first: litellm --config config.yaml
LITELLM_URL=http://localhost:4000
API_KEY=anything

# Model names as defined in config.yaml
LOCAL_MODEL=local-model
CLOUD_MODEL=cloud-model

# ── Direct OpenAI Fallback (optional) ─────────────────────────────────────────
# If OPENAI_API_KEY is set, the pipeline will call OpenAI directly when the
# LiteLLM proxy is unreachable, instead of crashing with "Connection error."
OPENAI_API_KEY=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
OPENAI_DIRECT_MODEL=gpt-4o-mini

# ── LLM Behaviour ─────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000
TIMEOUT=60
# Prompts longer than this (chars) are routed to the cloud model
MODEL_ROUTING_THRESHOLD=3000

# ── Model Training ─────────────────────────────────────────────────────────────
MAX_TRAINING_ITERATIONS=10
# Models to compare each iteration (remove any you don't want / haven't installed)
MODELS_TO_COMPARE=XGBoost,RandomForest,LightGBM,CatBoost,ExtraTrees
